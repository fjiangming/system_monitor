# Replace the domain and certificate paths before loading this virtual host.
server {
    listen 80;
    listen [::]:80;
    server_name monitor.example.com;

    if ($host != monitor.example.com) { return 444; }
    return 308 https://monitor.example.com$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name monitor.example.com;
    server_tokens off;

    ssl_certificate /etc/nginx/certs/monitor/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/monitor/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    if ($host != monitor.example.com) { return 444; }
    if ($ssl_server_name != monitor.example.com) { return 444; }

    resolver 127.0.0.11 valid=5s ipv6=off;
    set $monitor_backend http://system-monitor:18080;
    client_max_body_size 2m;

    location / {
        proxy_pass $monitor_backend;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Host "";
        proxy_set_header Connection "";
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }
}
